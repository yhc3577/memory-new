{
  "id": "memory_new",
  "doctorContract": {
    "configRepair": true,
    "stateMigrations": true
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": ["mem_new_search", "mem_new_store", "mem_new_get", "mem_new_distill"]
  },
  "hooks": {
    "allowConversationAccess": true,
    "allowPromptInjection": true
  },
  "name": "Memory New",
  "description": "Multi-layered memory system with decay, team memory, and hybrid retrieval",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean" },

      "layersEnabled": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "L0": { "type": "boolean" },
          "L1": { "type": "boolean" },
          "L2": { "type": "boolean" },
          "L3": { "type": "boolean" }
        }
      },

      "decay": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ttl": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "retentionDays": { "type": "number" },
              "safetyThreshold": { "type": "number" },
              "minRetainL0": { "type": "number" },
              "minRetainL1": { "type": "number" }
            }
          },
          "importance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "baseHalflifeDays": { "type": "number" }
            }
          },
          "accessFrequency": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" }
            }
          },
          "stateMachine": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" }
            }
          }
        }
      },

      "teamMemory": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "maxImportedAgents": { "type": "number" },
          "visibilityGate": { "type": "boolean" }
        }
      },

      "retrieval": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hybridSearch": { "type": "boolean" },
          "semanticWeight": { "type": "number" },
          "bm25Weight": { "type": "number" },
          "entityBoostWeight": { "type": "number" },
          "topK": { "type": "number" },
          "overFetch": { "type": "number" }
        }
      },

      "storage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "backend": { "type": "string", "enum": ["sqlite", "memory"] },
          "dataDir": { "type": "string" }
        }
      },

      "visualize": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "port": { "type": "number" },
          "autoStart": { "type": "boolean" }
        }
      }
    }
  },

  "uiHints": {
    "enabled": {
      "label": "Enable Memory New",
      "help": "Globally enable or disable the memory plugin"
    },
    "layersEnabled": {
      "label": "Memory Layers",
      "help": "Configure which memory distillation layers to use. L3 (user persona) is OFF by default — the plugin runs a dry-run preview instead and writes it to memory/l3-preview.json. Run `memory_new.l3_dry_run` to inspect."
    },
    "teamMemory": {
      "label": "Team Memory",
      "help": "Enable team memory sharing with visibility ACL and borrow/import limits"
    },
    "storage": {
      "label": "Storage Backend",
      "help": "memory = JSONL (zero deps, default). sqlite = better-sqlite3 (optionalDependency, falls back to memory if the native binary is missing or mismatched)."
    },
    "visualize": {
      "label": "Visualization Server",
      "help": "Standalone HTTP dashboard on 127.0.0.1:4123 (or MEMORY_NEW_PORT). Default off. Use `memory_new.visualize start` after enabling."
    }
  }
}
